/**app.wxss**/
view,
scroll-view,
swiper,
button,
image,
text {
  box-sizing: border-box;
}

button {
  background: initial;
  padding: 0;
  margin: 0;
  border: 0;
}

button:focus {
  outline: 0;
}

button::after {
  border: none;
}

page {
  background: #F5FAFF;
  color: #102A56;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}