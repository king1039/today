page {
  background: #F5FAFF;
}

.page {
  padding: 16rpx 28rpx 48rpx;
}

.minute-tip,
.market-card {
  background: #FFFFFF;
  border-radius: 24rpx;
}

.minute-tip {
  display: flex;
  align-items: center;
  padding: 22rpx 26rpx;
  background: #EAF6FF;
  color: #1689F8;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 28rpx;
}

.tip-sun {
  font-size: 34rpx;
  margin-right: 16rpx;
}

.market-card {
  padding: 28rpx 24rpx 8rpx;
  box-shadow: 0 6rpx 24rpx rgba(16, 42, 86, 0.04);
}

.section-heading {
  display: flex;
  justify-content: space-between;
  padding: 0 0 20rpx;
}

.section-title,
.section-subtitle {
  display: block;
}

.section-meta {
  text-align: right;
  white-space: nowrap;
}

.section-date,
.section-update {
  display: block;
}

.section-date {
  color: #102A56;
  font-size: 23rpx;
}

.section-update {
  color: #8494AD;
  font-size: 20rpx;
  margin-top: 4rpx;
}

.section-title {
  color: #1689F8;
  font-size: 34rpx;
  font-weight: 700;
}

.section-subtitle {
  color: #8494AD;
  font-size: 22rpx;
  margin-top: 7rpx;
}

.market-row {
  display: flex;
  align-items: center;
  min-height: 106rpx;
  border-top: 1rpx solid #EDF3F9;
}

.market-info {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.asset-icon {
  width: 48rpx;
  font-size: 34rpx;
  text-align: center;
  margin-right: 14rpx;
}

.market-label {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.market-name {
  color: #102A56;
  font-size: 27rpx;
  font-weight: 600;
}

.simple-text {
  color: #8494AD;
  font-size: 21rpx;
  margin-top: 5rpx;
}

.market-value {
  width: 175rpx;
  color: #102A56;
  font-size: 27rpx;
  font-weight: 600;
  text-align: right;
}

.market-change {
  width: 112rpx;
  font-size: 27rpx;
  font-weight: 600;
  text-align: right;
}

.rise { color: #F04444; }
.fall { color: #16A36A; }
.flat { color: #8494AD; }

.detail-layer {
  position: fixed;
  z-index: 10;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
}

.mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(16, 42, 86, 0.32);
}

.detail-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 75vh;
  max-height: 75vh;
  padding: 0;
  border-radius: 30rpx 30rpx 0 0;
  background: #FFFFFF;
}

.detail-content {
  padding: 30rpx 32rpx 36rpx;
}

.detail-header,
.detail-summary,
.poll-buttons {
  display: flex;
  align-items: center;
}

.detail-header {
  justify-content: space-between;
}

.detail-title {
  font-size: 34rpx;
  font-weight: 700;
}

.close-button {
  color: #8494AD;
  font-size: 48rpx;
  line-height: 1;
  padding: 0 8rpx;
}

.detail-summary {
  margin-top: 24rpx;
}

.detail-value {
  color: #102A56;
  font-size: 42rpx;
  font-weight: 700;
  margin-right: 28rpx;
}

.detail-change {
  font-size: 30rpx;
  font-weight: 700;
}

.detail-time,
.disclaimer {
  display: block;
  color: #8494AD;
  font-size: 21rpx;
  margin-top: 8rpx;
}

.trend-title {
  color: #102A56;
  font-size: 26rpx;
  font-weight: 600;
}

.trend-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}

.chart-period-tabs {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.chart-period-tab {
  color: #8494AD;
  font-size: 21rpx;
  padding: 6rpx 10rpx;
  border-radius: 8rpx;
}

.chart-period-tab.active {
  color: #1689F8;
  background: #EAF6FF;
}

.chart-history-notice {
  display: block;
  color: #A0ADBD;
  font-size: 20rpx;
  margin-top: 6rpx;
}

.market-chart {
  display: block;
  width: 100%;
  height: 300rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  margin-top: 12rpx;
}

.detail-explain {
  display: block;
  color: #526987;
  font-size: 24rpx;
  line-height: 1.6;
  margin-top: 18rpx;
}

.poll-section {
  margin-top: 22rpx;
}

.poll-question {
  display: block;
  color: #102A56;
  font-size: 25rpx;
  font-weight: 600;
}

.poll-buttons {
  margin-top: 16rpx;
}

.poll-button {
  flex: 1;
  height: 70rpx;
  line-height: 70rpx;
  border-radius: 35rpx;
  font-size: 25rpx;
  margin-right: 16rpx;
}

.poll-button:last-child {
  margin-right: 0;
}

.poll-up {
  color: #F04444;
  background: #FFF0F0;
}

.poll-down {
  color: #16A36A;
  background: #EAF9F2;
}

.poll-result,
.poll-participants {
  display: block;
  text-align: center;
  color: #526987;
  font-size: 22rpx;
  margin-top: 14rpx;
}

.poll-participants {
  color: #8494AD;
  margin-top: 5rpx;
}

.disclaimer {
  text-align: center;
  line-height: 1.5;
  margin-top: 22rpx;
}
