page { background: #F5FAFF; }
.life-page { width: 100%; padding: 30rpx 28rpx 48rpx; overflow-x: hidden; }
.life-tabs { display: flex; padding: 6rpx; border-radius: 24rpx; background: #EAF2FB; }
.life-tab { flex: 1; padding: 18rpx 4rpx; border-radius: 20rpx; color: #102A56; font-size: 27rpx; font-weight: 600; text-align: center; }
.life-tab.active { color: #FFFFFF; background: #1689F8; }
.tab-subtitle { display: block; font-size: 18rpx; margin-top: 4rpx; }
.long-tip { padding: 20rpx 22rpx; margin: 24rpx 0 4rpx; border-radius: 18rpx; background: #EAF6FF; color: #526987; font-size: 23rpx; }
.recent-grid { display: flex; flex-wrap: wrap; justify-content: space-between; margin-top: 24rpx; }
.indicator-card { width: calc(50% - 10rpx); min-height: 270rpx; margin-bottom: 20rpx; padding: 24rpx; border: 1rpx solid #E3EFF8; border-radius: 24rpx; background: #FFFFFF; }
.indicator-heading { display: flex; align-items: flex-start; }
.indicator-icon { font-size: 42rpx; line-height: 1; margin-right: 12rpx; }
.indicator-name-wrap { min-width: 0; }
.indicator-name { display: block; color: #102A56; font-size: 28rpx; font-weight: 700; }
.indicator-subtitle { display: block; overflow: hidden; color: #8494AD; font-size: 19rpx; line-height: 1.5; margin-top: 6rpx; text-overflow: ellipsis; white-space: nowrap; }
.indicator-value-row { display: flex; align-items: baseline; justify-content: space-between; margin-top: 24rpx; }
.indicator-value { color: #102A56; font-size: 31rpx; font-weight: 700; word-break: break-all; }
.indicator-change { flex-shrink: 0; font-size: 25rpx; font-weight: 700; margin-left: 6rpx; }
.unavailable { color: #8494AD; font-size: 24rpx; }
.last-known { display: block; color: #8494AD; font-size: 18rpx; margin-top: 6rpx; }
.rise { color: #F04444; } .fall { color: #16A36A; } .flat { color: #8494AD; }
.indicator-simple { display: block; min-height: 42rpx; color: #526987; font-size: 22rpx; line-height: 1.5; margin-top: 14rpx; }
.indicator-footer { display: flex; flex-wrap: wrap; color: #8494AD; font-size: 19rpx; line-height: 1.5; margin-top: 18rpx; }
.indicator-footer text + text { margin-left: 6rpx; }
.empty-life { padding: 140rpx 0; color: #8494AD; font-size: 26rpx; text-align: center; }
.detail-layer { position: fixed; z-index: 10; left: 0; right: 0; top: 0; bottom: 0; }
.mask { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background: rgba(16, 42, 86, .32); }
.detail-sheet { position: absolute; left: 0; right: 0; bottom: 0; height: 88vh; max-height: 88vh; border-radius: 30rpx 30rpx 0 0; background: #FFFFFF; }
.detail-content { padding: 30rpx 32rpx 44rpx; }
.detail-header { display: flex; align-items: flex-start; justify-content: space-between; }
.detail-title-wrap { display: flex; align-items: center; }
.detail-icon { font-size: 48rpx; margin-right: 16rpx; }
.detail-title { display: block; color: #102A56; font-size: 34rpx; font-weight: 700; }
.detail-meta, .detail-source, .detail-footer { display: block; color: #8494AD; font-size: 21rpx; line-height: 1.7; margin-top: 5rpx; }
.close-button { color: #8494AD; font-size: 48rpx; line-height: 1; padding: 0 8rpx; }
.detail-summary { display: flex; align-items: baseline; margin-top: 28rpx; }
.detail-value { color: #102A56; font-size: 42rpx; font-weight: 700; }
.life-trend-heading { margin-top: 24rpx; }
.life-trend-title-row { display: flex; align-items: center; justify-content: space-between; }
.life-trend-title { color: #102A56; font-size: 26rpx; font-weight: 600; }
.life-period-change { font-size: 26rpx; font-weight: 600; }
.life-period-tabs { display: flex; justify-content: flex-end; align-items: center; gap: 8rpx; margin-top: 6rpx; }
.life-period-tab { color: #8494AD; font-size: 21rpx; padding: 6rpx 10rpx; border-radius: 8rpx; }
.life-period-tab.active { color: #1689F8; background: #EAF6FF; }
.life-history-notice { display: block; color: #A0ADBD; font-size: 20rpx; margin-top: 6rpx; }
.indicator-chart { display: block; width: 100%; height: 300rpx; margin-top: 14rpx; background: #FFFFFF; }
.chart-unavailable { display: block; padding: 120rpx 0; color: #8494AD; font-size: 24rpx; text-align: center; }
.explain-box { padding: 22rpx; border-radius: 18rpx; background: #F0F8FF; margin-top: 20rpx; }
.explain-title { display: block; color: #102A56; font-size: 27rpx; font-weight: 700; margin-bottom: 10rpx; }
.explain-text { color: #526987; font-size: 24rpx; line-height: 1.7; }
.vote-section { margin-top: 24rpx; }
.vote-question { display: block; color: #102A56; font-size: 26rpx; font-weight: 700; margin-bottom: 14rpx; }
.vote-options { display: flex; justify-content: space-between; }
.vote-option { width: calc(33.33% - 8rpx); padding: 18rpx 4rpx; border-radius: 16rpx; text-align: center; font-size: 23rpx; line-height: 1.6; }
.vote-option.up { color: #F04444; background: #FFF0F0; } .vote-option.down { color: #16A36A; background: #EAF9F2; } .vote-option.flat, .vote-option.better { color: #526987; background: #F0F5FB; } .vote-option.worse { color: #16A36A; background: #EAF9F2; }
.detail-footer { margin-top: 26rpx; }
.disclaimer { display: block; color: #8494AD; font-size: 20rpx; line-height: 1.6; text-align: center; margin-top: 22rpx; }
