<view class="news-page">
  <view class="news-tabs">
    <view class="news-tab {{activeNewsType === 'international' ? 'active' : ''}}" data-type="international" bindtap="switchNewsType">国际新闻</view>
    <view class="news-tab {{activeNewsType === 'domestic' ? 'active' : ''}}" data-type="domestic" bindtap="switchNewsType">国内新闻</view>
  </view>

  <view wx:if="{{currentNewsList.length}}" class="top-news">
    <text class="top-news-title">今天就看这{{currentNewsList.length}}件</text>
    <view class="top-news-list">
      <view class="top-news-item" wx:for="{{topNews}}" wx:key="label" data-index="{{item.index}}" bindtap="openTopNews">
        <text>{{item.label}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{currentNewsList.length}}" class="news-list">
    <view class="news-card" wx:for="{{currentNewsList}}" wx:key="id" data-index="{{index}}" bindtap="openNewsDetail">
      <view class="news-image-wrap">
        <image wx:if="{{!item.imageFailed && item.imageUrl}}" class="news-image" src="{{item.imageUrl}}" mode="aspectFill" data-index="{{index}}" binderror="handleImageError"></image>
        <view wx:else class="news-image-placeholder"><text>📰</text></view>
      </view>
      <view class="news-card-content">
        <text class="news-title">{{item.title}}</text>
        <text class="news-summary">{{item.summary}}</text>
        <view class="news-card-bottom">
          <view class="tag-list">
            <text class="news-tag" wx:for="{{item.tags}}" wx:key="*this">{{item}}</text>
          </view>
          <text wx:if="{{item.cardTime}}" class="news-time">{{item.cardTime}}</text>
        </view>
      </view>
    </view>
  </view>
  <view wx:else class="empty-news">今天暂时没有需要特别留意的消息</view>

  <view wx:if="{{showNewsDetail}}" class="detail-layer">
    <view class="mask" catchtap="closeNewsDetail"></view>
    <scroll-view class="detail-sheet" scroll-y="true" catchtap="noop">
      <view class="detail-content">
        <view class="detail-top">
          <view class="detail-image-wrap">
            <image wx:if="{{!selectedNews.imageFailed && selectedNews.imageUrl}}" class="detail-image" src="{{selectedNews.imageUrl}}" mode="aspectFill" binderror="handleDetailImageError"></image>
            <view wx:else class="detail-image-placeholder"><text>📰</text></view>
          </view>
          <view class="detail-heading">
            <text class="detail-title">{{selectedNews.title}}</text>
            <text class="detail-meta">来源：{{selectedNews.source}}</text>
            <text wx:if="{{selectedNews.publishTime}}" class="detail-meta">发布时间：{{selectedNews.publishTime}}</text>
          </view>
          <text class="close-button" catchtap="closeNewsDetail">×</text>
        </view>
        <view wx:if="{{selectedNews.impactItems.length}}" class="detail-section">
          <text class="detail-section-title">发生了什么？</text>
          <text class="detail-text">{{selectedNews.eventSummary}}</text>
        </view>
        <view class="plain-explain">
          <text class="detail-section-title">大白话</text>
          <text class="detail-text">{{selectedNews.plainText}}</text>
        </view>
        <view class="detail-section">
          <text class="detail-section-title">可能影响</text>
          <view class="impact-item" wx:for="{{selectedNews.impactItems}}" wx:key="*this">
            <text class="impact-dot">•</text><text class="detail-text">{{item}}</text>
          </view>
        </view>
        <view wx:if="{{selectedNews.relationSteps.length}}" class="relation-box">
          <text class="detail-section-title">简单看关系</text>
          <block wx:for="{{selectedNews.relationSteps}}" wx:key="*this">
            <text class="relation-text">{{item}}</text>
            <text wx:if="{{index < selectedNews.relationSteps.length - 1}}" class="relation-arrow">↓</text>
          </block>
        </view>
        <text class="disclaimer">以上内容仅为公开信息整理和通俗解释，不构成任何投资、购房或交易建议。</text>
      </view>
    </scroll-view>
  </view>
</view>
