page {
  background: #F5FAFF;
}

.news-page {
  width: 100%;
  padding: 30rpx 28rpx 48rpx;
  overflow-x: hidden;
}

.news-header {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.brand-logo {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  margin-right: 18rpx;
}

.brand-copy {
  display: flex;
  flex-direction: column;
}

.brand-title {
  color: #102A56;
  font-size: 40rpx;
  font-weight: 700;
}

.brand-slogan {
  color: #8494AD;
  font-size: 22rpx;
  margin-top: 6rpx;
}

.news-tabs {
  display: flex;
  padding: 6rpx;
  border-radius: 24rpx;
  background: #EAF2FB;
}

.news-tab {
  flex: 1;
  color: #102A56;
  font-size: 29rpx;
  font-weight: 600;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 20rpx;
}

.news-tab.active {
  color: #FFFFFF;
  background: #1689F8;
}

.top-news {
  padding: 22rpx 4rpx 12rpx;
}

.top-news-title {
  display: block;
  color: #102A56;
  font-size: 27rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
}

.top-news-list {
  display: flex;
  white-space: nowrap;
}

.top-news-item {
  color: #1689F8;
  background: #EAF6FF;
  border-radius: 20rpx;
  font-size: 23rpx;
  padding: 12rpx 16rpx;
  margin-right: 12rpx;
}

.news-card {
  display: flex;
  width: 100%;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #E6EFF7;
}

.news-image-wrap,
.news-image,
.news-image-placeholder {
  width: 200rpx;
  height: 160rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
}

.news-image-placeholder,
.detail-image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #EAF6FF;
  color: #1689F8;
  font-size: 48rpx;
}

.news-card-content {
  min-width: 0;
  flex: 1;
  padding-left: 20rpx;
}

.news-card-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.news-title {
  display: -webkit-box;
  overflow: hidden;
  color: #102A56;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.news-time {
  flex-shrink: 0;
  color: #8494AD;
  font-size: 21rpx;
  margin-left: 10rpx;
}

.news-summary {
  display: -webkit-box;
  overflow: hidden;
  color: #6D819D;
  font-size: 23rpx;
  line-height: 1.5;
  margin-top: 8rpx;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.tag-list {
  display: flex;
  margin-top: 10rpx;
}

.news-tag {
  color: #1689F8;
  background: #EAF6FF;
  border-radius: 12rpx;
  font-size: 20rpx;
  padding: 5rpx 10rpx;
  margin-right: 8rpx;
}

.empty-news {
  padding: 120rpx 0;
  color: #8494AD;
  font-size: 26rpx;
  text-align: center;
}

.detail-layer {
  position: fixed;
  z-index: 10;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
}

.mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(16, 42, 86, 0.32);
}

.detail-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 85vh;
  max-height: 85vh;
  border-radius: 30rpx 30rpx 0 0;
  background: #FFFFFF;
}

.detail-content {
  padding: 30rpx 32rpx 44rpx;
}

.detail-top {
  position: relative;
  display: flex;
  padding-right: 54rpx;
}

.detail-image-wrap,
.detail-image,
.detail-image-placeholder {
  width: 190rpx;
  height: 150rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
}

.detail-heading {
  display: flex;
  flex-direction: column;
  padding-left: 18rpx;
}

.detail-title {
  color: #102A56;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.45;
}

.detail-meta {
  color: #8494AD;
  font-size: 21rpx;
  line-height: 1.7;
  margin-top: 6rpx;
}

.close-button {
  position: absolute;
  right: 0;
  top: -8rpx;
  color: #8494AD;
  font-size: 48rpx;
  line-height: 1;
}

.detail-section,
.plain-explain,
.relation-box {
  margin-top: 28rpx;
}

.detail-section-title {
  display: block;
  color: #102A56;
  font-size: 29rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.detail-text {
  color: #526987;
  font-size: 25rpx;
  line-height: 1.7;
}

.plain-explain,
.relation-box {
  padding: 22rpx;
  border-radius: 18rpx;
  background: #F0F8FF;
}

.impact-item {
  display: flex;
  align-items: flex-start;
  margin: 8rpx 0;
}

.impact-dot {
  color: #1689F8;
  font-size: 30rpx;
  line-height: 1.4;
  margin-right: 10rpx;
}

.relation-text {
  display: block;
  color: #526987;
  font-size: 25rpx;
  line-height: 1.8;
}

.disclaimer {
  display: block;
  color: #8494AD;
  font-size: 20rpx;
  line-height: 1.6;
  text-align: center;
  margin-top: 30rpx;
}
